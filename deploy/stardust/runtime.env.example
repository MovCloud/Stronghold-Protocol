# Public release coordinates; copy to runtime.env only after loading/verifying these images.
# A template is not proof of activation; check the release record and live health.
ARK_GAME_IMAGE=ark-proto:v013-ui-20261005
ARK_AUTH_IMAGE=ark-proto-auth:v013-ui-20261005
ARK_ASSETS_IMAGE=ark-proto-assets:v013-ui-20261005
# Separate from the fixed six combat Workers: 0=inline trials, 1=cost-first default, 2=lower trial queue latency.
SP_TRIAL_WORKERS=1
# The download source of 设置 → 素材下载: empty (default) = the page's own origin; an absolute origin or a same-origin
# path prefix (e.g. /cdn) offloads the asset queue. Read by server/http/config.js (SP_ASSET_ORIGIN) and answered at
# /data/asset-source.json.
SP_ASSET_ORIGIN=
