# Copy to feedback.env (not committed) next to compose.feedback.yaml. No secrets here.

# The site's origin: every POST must carry exactly this Origin.
FEEDBACK_ORIGIN=https://game.example.com
# Host directory of the SQLite file and its daily backups (owner 1000:1000, mode 0700).
FEEDBACK_DATA_DIR=/opt/ark-ops/feedback/data
FEEDBACK_IMAGE=ark-feedback:local
